# hosts.env — dispatcher-side settings for the shell tools (mac_wait.sh, relay_via_host.sh, start-tailscaled.sh).
# Copy to $HARNESS_HOME/hosts.env and chmod 600. It is sourced by bash: plain KEY=VALUE lines only.
# All addresses below are placeholders.

# SOCKS5 proxy exposed by the userspace tailscaled on the dispatcher box (start-tailscaled.sh).
HARNESS_SOCKS_ADDR=127.0.0.1:10555          # default port 10555; change both here and in start-tailscaled

# Mac bridges reachable from this box: space-separated alias=tailnet-ip:port pairs.
MAC_HOSTS="mac-a=100.x.y.1:18542 mac-b=100.x.y.2:18542"

# Optional fallback relay (relay_via_host.sh): when the box cannot reach a Mac bridge directly,
# SSH to a relay host (restricted key) and curl the bridge from there.
RELAY_SSH_TARGET=<relay-user>@100.x.y.3
RELAY_SSH_KEY=ssh/id_ed25519_relay          # relative to $HARNESS_HOME or absolute
RELAY_TARGET_HOSTPORT=100.x.y.1:18542       # the bridge the relay should reach

# Ledger appended by the wait scripts (one JSON line per finished job). "-" disables it.
# HARNESS_LEDGER=$HARNESS_HOME/harness-ledger.jsonl
